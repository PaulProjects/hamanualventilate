{
  "name": "ventilation-card",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "yarn@4.12.0",
  "description": "A Home Assistant Lovelace card that provides smart manual ventilation guidance based on indoor/outdoor temperature and humidity",
  "keywords": [
    "home-assistant",
    "homeassistant",
    "hass",
    "lovelace",
    "custom-cards",
    "ventilation",
    "humidity",
    "temperature"
  ],
  "module": "ventilation-card.js",
  "repository": "git@github.com:custom-cards/ventilation-card.git",
  "license": "MIT",
  "dependencies": {
    "custom-card-helpers": "2.0.0",
    "home-assistant-js-websocket": "9.6.0",
    "lit": "^3.3.2"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^26.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.2.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.39.1",
    "prettier": "^3.8.1",
    "rollup": "^4.20.0",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-serve": "^1.1.1",
    "tslib": "^2.6.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
